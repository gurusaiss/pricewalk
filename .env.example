# --- App ---
ENV=development

# --- Database (local dev: matches infra/docker-compose.yml) ---
DATABASE_URL=postgresql+psycopg://pricewalk:pricewalk@localhost:5432/pricewalk

# --- Redis / jobs ---
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=10080

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Brevo (email OTP) - free tier, no domain required to send to any recipient.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@pricewalk.app

# --- Alerts ---
# Create a bot with @BotFather on Telegram to get these.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# --- Billing (Razorpay, seller plans only) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Plan ids created in the Razorpay dashboard (Subscriptions > Plans), one per
# paid plan in core/plans.py.
RAZORPAY_PLAN_ID_STARTER=
RAZORPAY_PLAN_ID_GROWTH=

# --- Buyer outbound links ---
AFFILIATE_TAG_AMAZON=
AFFILIATE_TAG_FLIPKART=

# --- Monitoring (optional, M11) ---
SENTRY_DSN=

# --- Frontend (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
