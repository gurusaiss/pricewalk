# --- App ---
ENV=development
# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGINS=http://localhost:3000

# --- Database (local dev: matches infra/docker-compose.yml) ---
DATABASE_URL=postgresql+psycopg://pricewalk:pricewalk@localhost:5432/pricewalk

# --- Redis / jobs ---
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=10080

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Primary login is email + password (/auth/register, /auth/login) - none of
# the email settings below are required for that. They're only for the
# still-built-but-unwired OTP login path (/auth/otp/*), kept for whenever a
# free, phone-free email provider becomes available, or Render's SMTP block
# no longer applies (e.g. a paid plan). Priority when more than one is set:
# Mailjet > SMTP > Brevo.

# Mailjet (HTTPS API, works on hosts like Render that block outbound SMTP).
# Free tier: 6,000 emails/month, no card - but signup has reportedly
# required a phone number for some accounts; verify before relying on it.
MAILJET_API_KEY=
MAILJET_API_SECRET=
MAILJET_SENDER_EMAIL=noreply@pricewalk.app

# SMTP (e.g. Gmail: smtp.gmail.com, port 465, your Gmail address as username,
# an app password from Google Account > Security > 2-Step Verification > App
# passwords). Only works on hosts that allow outbound SMTP - Render's free
# tier blocks it entirely.
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER_EMAIL=

# Brevo (email OTP) - free tier, no domain required to send to any
# recipient, but signup now requires phone verification.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@pricewalk.app

# --- Alerts ---
# Create a bot with @BotFather on Telegram to get these.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Your own Telegram chat id (message the bot once, then check
# https://api.telegram.org/bot<token>/getUpdates) - receives the daily admin report.
ADMIN_TELEGRAM_CHAT_ID=

# --- Billing (Razorpay, seller plans only) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Plan ids created in the Razorpay dashboard (Subscriptions > Plans), one per
# paid plan in core/plans.py.
RAZORPAY_PLAN_ID_STARTER=
RAZORPAY_PLAN_ID_GROWTH=

# --- Buyer outbound links ---
AFFILIATE_TAG_AMAZON=
AFFILIATE_TAG_FLIPKART=

# --- Monitoring (optional, M11) ---
SENTRY_DSN=

# --- Frontend (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
