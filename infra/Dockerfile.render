FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml ./
COPY packages/core ./packages/core
COPY services/api ./services/api
COPY services/worker ./services/worker
COPY infra/start-api.sh ./start-api.sh

RUN pip install --no-cache-dir -e . && chmod +x ./start-api.sh

# render.yaml's dockerCommand picks which of api/worker actually runs per
# service; this default CMD only matters if a service is started without one.
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
